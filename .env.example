# ==========================================
# Catlazy Architecture Configuration
# ==========================================

# Optional Headroom Context Compression Proxy
# Route API traffic through the local proxy only when you choose to use it.
OPENAI_BASE_URL=http://localhost:8787/v1
ANTHROPIC_BASE_URL=http://localhost:8787/v1

# Set your normal API keys; the proxy forwards them.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
